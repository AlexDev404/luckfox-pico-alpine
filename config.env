# Build settings. The Luckfox SDK version is pinned by the sdk/ submodule.

# Alpine release used for the root filesystem (arm32v7/alpine:<tag> on Docker Hub)
ALPINE_VERSION=3.24

# Board config inside the SDK (sdk/project/cfg/BoardConfig_IPC/)
BOARD_CONFIG=BoardConfig-SD_CARD-Buildroot-RV1103_Luckfox_Pico-IPC.mk

# Default root password baked into the image (documented in README; change it
# with `passwd` after first boot). A ROOT_PASSWORD_HASH secret/env overrides it.
ROOT_PASSWORD=toor

# Luckfox's Ubuntu 22.04 build environment (newer hosts break the SDK)
SDK_IMAGE=luckfoxtech/luckfox_pico:1.0
